{
  "name": "jarvis-agent",
  "version": "0.0.0",
  "private": true,
  "description": "Jarvis-Agent — a coding-agent CLI: stateful host + pure-function decision points. Phases A/B + persistence complete; Phase C (multi-agent) next.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx src/surfaces/cli/index.ts",
    "resume": "tsx src/surfaces/cli/index.ts --resume",
    "goal": "tsx src/surfaces/cli/goal-cli.ts",
    "loop": "tsx src/surfaces/cli/loop-cli.ts",
    "resume:loop": "tsx src/surfaces/cli/loop-cli.ts --resume",
    "loop:finalize": "tsx src/surfaces/cli/loop-finalize-cli.ts",
    "cron": "tsx src/surfaces/cli/cron-cli.ts",
    "cron:daemon": "tsx src/surfaces/cli/cron-daemon-cli.ts",
    "shadow": "tsx src/surfaces/cli/shadow-cli.ts",
    "demo:a1": "tsx scripts/a1-demo.ts",
    "demo:a2": "tsx scripts/a2-demo.ts",
    "demo:a3": "tsx scripts/a3-demo.ts",
    "demo:a5": "tsx scripts/a5-demo.ts",
    "demo:b1": "tsx scripts/b1-demo.ts",
    "demo:b3": "tsx scripts/b3-demo.ts",
    "demo:c1": "tsx scripts/c1-demo.ts",
    "demo:c2": "tsx scripts/c2-demo.ts",
    "demo:d1": "tsx scripts/d1-demo.ts",
    "demo:d2": "tsx scripts/d2-demo.ts",
    "demo:d3": "tsx scripts/d3-demo.ts",
    "demo:vision": "tsx scripts/vision-demo.ts",
    "sandbox:smoke": "tsx scripts/os-sandbox-smoke.ts",
    "sandbox:runner-smoke": "tsx scripts/os-sandbox-runner-smoke.ts",
    "sandbox:goal-smoke": "tsx scripts/os-sandbox-goal-smoke.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src test"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "mvdan-sh": "^0.10.1",
    "openai": "^6.45.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.0.1",
    "eslint": "^10.5.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.0",
    "vitest": "^4.1.9"
  }
}
