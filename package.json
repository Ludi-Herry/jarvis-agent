{
  "name": "jarvis-agent",
  "version": "0.0.0",
  "private": true,
  "description": "Jarvis-Agent — a coding-agent CLI: stateful host + pure-function decision points. Phase A complete.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx src/surfaces/cli/index.ts",
    "demo:a1": "tsx scripts/a1-demo.ts",
    "demo:a2": "tsx scripts/a2-demo.ts",
    "demo:a3": "tsx scripts/a3-demo.ts",
    "demo:a5": "tsx scripts/a5-demo.ts",
    "demo:b1": "tsx scripts/b1-demo.ts",
    "demo:b3": "tsx scripts/b3-demo.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src test"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "ink": "^7.1.0",
    "openai": "^6.45.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.0.1",
    "eslint": "^10.5.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.0",
    "vitest": "^4.1.9"
  }
}
